<Window x:Class="DeSwitcher.Patcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="deSwitcher" Width="980" Height="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="OnChromeDrag" Background="#0A0A0B">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="deSwitcher 1.0" Style="{StaticResource Dimmed}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11.5"/>
                <Button Grid.Column="1" x:Name="LangButton" Style="{StaticResource ChromeButton}" Width="54" Click="OnToggleLang">
                    <TextBlock x:Name="LangText" FontFamily="{StaticResource Pixel}" FontSize="9" TextOptions.TextRenderingMode="Aliased"/>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Style="{StaticResource ChromeButton}" Click="OnMinimize">
                        <Path Style="{StaticResource Icon}" Width="15" Height="15" Data="M5 12h14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="OnClose">
                        <Path Style="{StaticResource Icon}" Width="14" Height="14" Data="M18 6 6 18 M6 6 l12 12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="Root"/>
        </Grid>
    </Border>
</Window>
