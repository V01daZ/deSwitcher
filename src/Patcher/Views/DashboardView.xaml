<UserControl x:Class="DeSwitcher.Patcher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0A0A0B" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="14,20,14,16">
                <TextBlock DockPanel.Dock="Top" Text="deswitcher" Style="{StaticResource Wordmark}" FontSize="16" Margin="6,0,0,22"/>
                <StackPanel x:Name="Nav" DockPanel.Dock="Top"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GuardLine" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="PageKicker" Style="{StaticResource Dimmed}" FontSize="11"/>
                <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,2"/>
                <TextBlock x:Name="PageSub" Style="{StaticResource Dimmed}"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListHost"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="8" Padding="12,9"
                    Background="#121F23" BorderBrush="#2A4A52" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="OnBanner">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource Cyan}" VerticalAlignment="Center"
                          Data="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M9 12 l2 2 4-4"/>
                    <TextBlock x:Name="Banner" Margin="10,0,0,0" FontSize="11.5" Foreground="#CDEFF7" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
