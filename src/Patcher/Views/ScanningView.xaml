<UserControl x:Class="DeSwitcher.Patcher.Views.ScanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                <Ellipse Width="64" Height="64" Stroke="#1E1E22" StrokeThickness="4"/>
                <Path Stroke="{StaticResource Moon}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 32,2 A 30,30 0 0 1 60,26" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="Spin"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>
            <TextBlock x:Name="Title" FontSize="14" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            <TextBlock x:Name="Count" FontSize="12.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
